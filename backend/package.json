{
  "name": "@proactive/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "tsx --env-file=.env watch src/main.ts",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js",
    "prisma:generate": "prisma generate",
    "prisma:seed": "sh -c 'set -a && . ./.env && set +a && tsx prisma/seed.ts'",
    "prisma:seed:e2e": "sh -c 'set -a && . ./.env && set +a && npx prisma migrate deploy && E2E_ALLOW_DATABASE_SEED=true tsx prisma/seed.e2e.ts'",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^7.0.1",
    "csv-stringify": "^6.8.1",
    "iconv-lite": "^0.7.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "2.2.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "2.2.0",
    "@types/node": "^24.10.13",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "jest": "^30.3.0",
    "prisma": "7.9.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
