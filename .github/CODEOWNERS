# CODEOWNERS — require the repository owner to review changes to
# security-critical files so that no dependency or workflow update
# can slip through without explicit sign-off.


# Supply-chain and dependency management
package.json                    @rhamenator
package-lock.json               @rhamenator
**/package.json                 @rhamenator
.github/dependabot.yml          @rhamenator

# CI/CD workflows — a compromised workflow can exfiltrate secrets
.github/workflows/              @rhamenator
